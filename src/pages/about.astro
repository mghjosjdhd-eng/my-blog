import Layout from '../layouts/Layout.astro';
---

<Layout title="关于我">
  <section class="about-page">
    <h1>🙋 关于我</h1>
    <p>
      你好！我是一名热爱技术的开发者，正在不断学习和探索编程世界。
    </p>
    <p>
      这个博客是我记录学习过程的地方。我会在这里分享：
    </p>
    <ul>
      <li>学习新技术的心得体会</li>
      <li>解决实际问题的经验总结</li>
      <li>项目实践中的思考和收获</li>
    </ul>
    <p>
      本站使用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，
      托管在 <a href="https://pages.github.com" target="_blank" rel="noopener">GitHub Pages</a>，
      通过 GitHub Actions 自动部署。
    </p>
  </section>
</Layout>
